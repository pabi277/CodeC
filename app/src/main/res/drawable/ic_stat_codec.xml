        android:fillColor="#FFFFFF"
        android:pathData="M6,4 L14,12 L6,20 L4,18 L10,12 L4,6 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10,16.7 L20.4,16.7 L20.4,20 L10,20 Z" />
</vector>
